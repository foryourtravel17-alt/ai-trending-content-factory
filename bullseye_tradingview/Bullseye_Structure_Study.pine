//@version=6
indicator("Bullseye Theory — Five Pillar Study", shorttitle="BULLSEYE", overlay=true, max_labels_count=300, max_lines_count=100)

// EDUCATIONAL CHART STUDY ONLY. Does not place orders or give personalized advice.
// The rules below follow the original Bullseye five-pillar brief. Compile/test in TradingView before use.

string groupScope = "01 | SCOPE"
string scopeTf = input.timeframe("240", "Scope timeframe (FX/Crypto H4; Stocks select 1D)", group=groupScope)
int scopeFastLen = input.int(50, "Scope EMA fast", minval=2, group=groupScope)
int scopeSlowLen = input.int(200, "Scope EMA slow", minval=3, group=groupScope)
// Prior completed higher-timeframe candles reduce repainting.
float scopeFast = request.security(syminfo.tickerid, scopeTf, ta.ema(close, scopeFastLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float scopeSlow = request.security(syminfo.tickerid, scopeTf, ta.ema(close, scopeSlowLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
bool scopeBull = scopeFast > scopeSlow
bool scopeBear = scopeFast < scopeSlow
bool scopeFlat = not scopeBull and not scopeBear

string groupTarget = "02 | TARGET"
int pullbackLen = input.int(21, "Pullback EMA", minval=2, group=groupTarget)
int atrLen = input.int(14, "ATR length", minval=1, group=groupTarget)
float zoneMult = input.float(0.5, "Zone half-width (ATR)", minval=0.1, step=0.1, group=groupTarget)
float ema21 = ta.ema(close, pullbackLen)
float atr = ta.atr(atrLen)
float zoneHigh = ema21 + atr * zoneMult
float zoneLow = ema21 - atr * zoneMult
bool touchedZone = low <= zoneHigh and high >= zoneLow
plot(ema21, "EMA 21", color=color.aqua)
pHi = plot(zoneHigh, "Pullback zone upper", color=color.new(color.blue, 25))
pLo = plot(zoneLow, "Pullback zone lower", color=color.new(color.blue, 25))
fill(pHi, pLo, color=color.new(color.blue, 88), title="Blue pullback zone")

string groupTrigger = "03 | TRIGGER"
float minBodyPct = input.float(55.0, "Engulfing body minimum (% range)", minval=5, maxval=100, step=5, group=groupTrigger)
float wickRatio = input.float(2.0, "Pin-bar wick/body ratio", minval=1, maxval=6, step=0.25, group=groupTrigger)
float candleRange = math.max(high - low, syminfo.mintick)
float body = math.abs(close - open)
float bodyPct = body / candleRange * 100.0
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
bool bullEngulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1] and bodyPct >= minBodyPct
bool bearEngulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1] and bodyPct >= minBodyPct
bool bullPin = close > open and lowerWick >= math.max(body, syminfo.mintick) * wickRatio and upperWick <= math.max(body, syminfo.mintick)
bool bearPin = close < open and upperWick >= math.max(body, syminfo.mintick) * wickRatio and lowerWick <= math.max(body, syminfo.mintick)
bool bullishTrigger = barstate.isconfirmed and scopeBull and touchedZone and (bullEngulf or bullPin) and close > zoneHigh
bool bearishTrigger = barstate.isconfirmed and scopeBear and touchedZone and (bearEngulf or bearPin) and close < zoneLow

string groupGuards = "04 | GUARDRAILS"
string sessionHours = input.session("1200-2000:1234567", "Allowed session (India time)", group=groupGuards)
int maxPerDay = input.int(2, "Maximum setups per India day", minval=1, maxval=10, group=groupGuards)
bool newsBlackout = input.bool(false, "Manual high-impact news blackout", tooltip="Enable for the 15 minutes before/after important scheduled news. No live news calendar is connected.", group=groupGuards)
float riskPct = input.float(1.0, "Reference max risk (% equity)", minval=0.1, maxval=5.0, step=0.1, group=groupGuards)
bool inSession = not na(time(timeframe.period, sessionHours, "Asia/Kolkata"))
int dayKey = year(time, "Asia/Kolkata") * 10000 + month(time, "Asia/Kolkata") * 100 + dayofmonth(time, "Asia/Kolkata")
var int setupsToday = 0
if na(dayKey[1]) or dayKey != dayKey[1]
    setupsToday := 0
bool hasDailyRoom = setupsToday < maxPerDay
bool guardsPass = inSession and not newsBlackout and hasDailyRoom

string groupRisk = "05 | SHIELD + BULLSEYE"
float stopAtr = input.float(1.5, "Stop beyond zone (ATR)", minval=0.1, step=0.1, group=groupRisk)
float finalR = input.float(2.0, "Final target (R)", minval=1.0, step=0.25, group=groupRisk)
float partialR = input.float(1.0, "Partial reference (R)", minval=0.5, maxval=1.5, step=0.25, group=groupRisk)
float partialPct = input.float(50.0, "Partial reference exit (%)", minval=10, maxval=90, step=5, group=groupRisk)
bool showLevels = input.bool(true, "Show latest stop/1R/target", group=groupRisk)
int lineBars = input.int(30, "Reference line length (bars)", minval=5, maxval=250, group=groupRisk)
string sizeChoice = input.string("Small", "Setup label size", options=["Tiny", "Small", "Normal"], group=groupRisk)
string markerSize = sizeChoice == "Tiny" ? size.tiny : sizeChoice == "Normal" ? size.normal : size.small
bool longSetup = bullishTrigger and guardsPass
bool shortSetup = bearishTrigger and guardsPass

var line stopLine = na
var line partialLine = na
var line targetLine = na
var label levelLabel = na
if longSetup or shortSetup
    setupsToday += 1
    if not na(stopLine)
        line.delete(stopLine)
    if not na(partialLine)
        line.delete(partialLine)
    if not na(targetLine)
        line.delete(targetLine)
    if not na(levelLabel)
        label.delete(levelLabel)
    float entryRef = close
    float stopRef = longSetup ? zoneLow - atr * stopAtr : zoneHigh + atr * stopAtr
    float riskDist = math.abs(entryRef - stopRef)
    float partialRef = longSetup ? entryRef + riskDist * partialR : entryRef - riskDist * partialR
    float targetRef = longSetup ? entryRef + riskDist * finalR : entryRef - riskDist * finalR
    if showLevels and riskDist > syminfo.mintick
        stopLine := line.new(bar_index, stopRef, bar_index + lineBars, stopRef, xloc=xloc.bar_index, extend=extend.none, color=color.red, style=line.style_dashed)
        partialLine := line.new(bar_index, partialRef, bar_index + lineBars, partialRef, xloc=xloc.bar_index, extend=extend.none, color=color.orange, style=line.style_dashed)
        targetLine := line.new(bar_index, targetRef, bar_index + lineBars, targetRef, xloc=xloc.bar_index, extend=extend.none, color=color.lime, style=line.style_dashed)
        string direction = longSetup ? "BULL SCOPE" : "BEAR SCOPE"
        string msg = direction + "\nEntry reference: " + str.tostring(entryRef, format.mintick) + "\nStop reference: " + str.tostring(stopRef, format.mintick) + "\nPartial " + str.tostring(partialPct) + "% at " + str.tostring(partialR) + "R\nFinal reference: " + str.tostring(targetRef, format.mintick) + "\nStudy only"
        levelLabel := label.new(bar_index, longSetup ? low : high, msg, style=longSetup ? label.style_label_up : label.style_label_down, color=color.new(color.black, 5), textcolor=color.white, size=markerSize)

plotshape(longSetup, title="Bullish setup candidate", text="BULLSEYE\nSETUP", style=shape.labelup, location=location.belowbar, color=color.rgb(190, 255, 0), textcolor=color.black, size=size.tiny)
plotshape(shortSetup, title="Bearish setup candidate", text="BULLSEYE\nSETUP", style=shape.labeldown, location=location.abovebar, color=color.rgb(255, 84, 104), textcolor=color.white, size=size.tiny)

var table panel = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    string scopeStatus = scopeBull ? "BULL" : scopeBear ? "BEAR" : "FLAT"
    string targetStatus = touchedZone ? "ZONE TOUCHED" : "WAIT FOR ZONE"
    string triggerStatus = bullEngulf or bullPin ? "BULL CANDLE" : bearEngulf or bearPin ? "BEAR CANDLE" : "WAIT FOR PATTERN"
    string shieldStatus = newsBlackout ? "NEWS BLACKOUT" : "STOP 1.5 ATR PAST ZONE"
    string bullseyeStatus = str.tostring(partialPct) + "% AT " + str.tostring(partialR) + "R / REST " + str.tostring(finalR) + "R"
    string guardStatus = not inSession ? "OUTSIDE SESSION" : newsBlackout ? "NEWS BLACKOUT" : setupsToday >= maxPerDay ? "DAILY CAP REACHED" : str.tostring(setupsToday) + "/" + str.tostring(maxPerDay) + " SETUPS"
    table.cell(panel, 0, 0, "BULLSEYE THEORY", bgcolor=color.rgb(10, 18, 29), text_color=color.white)
    table.cell(panel, 1, 0, "STUDY ONLY", bgcolor=color.rgb(10, 18, 29), text_color=color.lime)
    table.cell(panel, 0, 1, "SCOPE", text_color=color.silver)
    table.cell(panel, 1, 1, scopeStatus, text_color=color.white, bgcolor=scopeBull ? color.new(color.green, 50) : scopeBear ? color.new(color.red, 50) : color.new(color.gray, 60))
    table.cell(panel, 0, 2, "TARGET", text_color=color.silver)
    table.cell(panel, 1, 2, targetStatus, text_color=color.white, bgcolor=touchedZone ? color.new(color.blue, 50) : color.new(color.gray, 70))
    table.cell(panel, 0, 3, "TRIGGER", text_color=color.silver)
    table.cell(panel, 1, 3, triggerStatus, text_color=color.white, bgcolor=(bullEngulf or bullPin or bearEngulf or bearPin) ? color.new(color.orange, 50) : color.new(color.gray, 70))
    table.cell(panel, 0, 4, "SHIELD", text_color=color.silver)
    table.cell(panel, 1, 4, shieldStatus, text_color=color.white, bgcolor=newsBlackout ? color.new(color.red, 35) : color.new(color.gray, 70))
    table.cell(panel, 0, 5, "BULLSEYE", text_color=color.silver)
    table.cell(panel, 1, 5, bullseyeStatus, text_color=color.white, bgcolor=color.new(color.green, 60))
    table.cell(panel, 0, 6, "GUARDRAILS", text_color=color.silver)
    table.cell(panel, 1, 6, guardStatus, text_color=color.white, bgcolor=guardsPass ? color.new(color.green, 65) : color.new(color.red, 65))
    table.cell(panel, 0, 7, "RISK RULE", text_color=color.silver)
    table.cell(panel, 1, 7, str.tostring(riskPct) + "% MAX (MANUAL SIZING)", text_color=color.white, bgcolor=color.new(color.gray, 65))

alertcondition(longSetup, title="Bullseye bullish setup (educational)", message="Bullseye bullish setup confirmed on {{ticker}} / {{interval}}. Chart study only, not a trade recommendation.")
alertcondition(shortSetup, title="Bullseye bearish setup (educational)", message="Bullseye bearish setup confirmed on {{ticker}} / {{interval}}. Chart study only, not a trade recommendation.")
